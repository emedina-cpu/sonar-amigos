{
  "name": "sonar-amigos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm run android:sync && node scripts/apk.mjs",
    "build:web": "node scripts/sounds.mjs && vite build",
    "server": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "android:sync": "pnpm run build:web && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "prettier": "^3.9.6",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
